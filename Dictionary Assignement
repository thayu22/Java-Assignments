import java.util.*;
import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;

public class Dictionary {
	public static void main(String[] args) throws IOException{
		HashSet<String> dictionary = new HashSet<>();
		BufferedReader inputStream = null;
		String line;

		try{
			inputStream = new BufferedReader(new FileReader("Dictionary.txt"));
			while ((line = inputStream.readLine()) != null) {
				dictionary.add(line.trim());
			}
		} catch (IOException e) {
			System.out.println("Unable to read dictionary");
			return;
		}
		
		Scanner input = new Scanner(System.in);

		System.out.println("Enter a Sentence: ");
		String inputSentence = input.nextLine();

		String[] inputWords = inputSentence.split(" ");

		for ( String word : inputWords) {
			String perfectInput = word.toLowerCase().replaceAll("\\s+", " ").trim();

			if (dictionary.contains(perfectInput)) {
				System.out.println(word + "<valid>");
			} else {
				System.out.println(word + "<Invalid>");
			}
		}
	input.close();
	inputStream.close();
	}
}
